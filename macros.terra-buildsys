# Declarative buildsystem macros for use in Terra exclusive packages (usable with rpm >= 4.20)
# https://rpm-software-management.github.io/rpm/manual/buildsystem.html

## Cargo

### Definition for "cargo" for prep stage, overriding default prep and using the cargo_prep_online macro
%buildsystem_terra_cargo_prep() \
%autosetup -C -p1 \
%cargo_prep_online -u %{*}

### Definition for "cargo" for genbr stage to determine BuildRequires
### Terra does not need this as we fetch rust deps online
%buildsystem_terra_cargo_generate_buildrequires() %{nil}

### Definition for "cargo" for conf stage, setting as empty due to non-use
%buildsystem_terra_cargo_conf() %{nil}

### Definition for "cargo" for build stage for compiling with cargo
%buildsystem_terra_cargo_build() %cargo_build_crate %{*}

### Definition for "cargo" for install stage to install files into buildroot
### Terra does not support %%cargo_install_crate, so we instead use %%crate_install_bin.
### %%install -s must be used to install aditional files
%buildsystem_terra_cargo_install() %terra_cargo_install %{*}

### Definition for "cargo" for check stage to run tests
%buildsystem_terra_cargo_check() %{?with_check:%cargo_test %{*}} %{!?with_check:%{nil}}

