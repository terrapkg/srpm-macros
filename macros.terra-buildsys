# Declarative buildsystem macros for use in Terra exclusive packages (usable with rpm >= 4.20)
# https://rpm-software-management.github.io/rpm/manual/buildsystem.html

## Cargo

### Definition for "cargo" for prep stage, overriding default prep and using the cargo_prep_online macro
%buildsystem_terra_cargo_prep() \
%autosetup -C -p1 \
%cargo_prep_online %{*} \
echo "Printing license summary for License field..." \
%cargo_license_preamble_online

### Definition for "cargo" for genbr stage to determine BuildRequires
### Fetches system deps checked against a database
%buildsystem_terra_cargo_generate_buildrequires() %terra_cargo_generate_buildrequires %{*}

### Definition for "cargo" for conf stage, setting as empty due to non-use
%buildsystem_terra_cargo_conf() %{nil}

### Definition for "cargo" for build stage for compiling with cargo
%buildsystem_terra_cargo_build() %cargo_build_crate %{*}

### Definition for "cargo" for install stage to install files into buildroot
### Terra does not support %%cargo_install_crate, so we instead use %%terra_cargo_install.
### %%install -s must be used to install aditional files
%buildsystem_terra_cargo_install() %terra_cargo_install %{*}

### Definition for "cargo" for check stage to run tests
%buildsystem_terra_cargo_check() %{?with_check:%cargo_test %{*}} %{!?with_check:%{nil}}

## Nimble

### Definition for "nimble" for prep stage, overriding default prep and using the nimble_prep macro
%buildsystem_nimble_prep() \
%autosetup -C -p1 \
%nimble_prep

### Definition for "nimble" for genbr stage to determine BuildRequires, setting as empty due to non-use
%buildsystem_nimble_generate_buildrequires() %{nil}

### Definition for "nimble" for conf stage, setting as empty due to non-use
%buildsystem_nimble_conf() %{nil}

### Definition for "cargo" for build stage for compiling with cargo
%buildsystem_nimble_build() %nimble_build %{*}

### Definition for "nimble" for install stage to install files into buildroot
%buildsystem_nimble_install() %nimble_install %{*}

### Definition for "nimble" for check stage to run tests, setting as empty due to non-use
%buildsystem_nimble_check() %{nil}

## Cabal

### prep: unpack, freeze and fetch deps, then print dep licenses for License:
%buildsystem_terra_cabal_prep() \
%autosetup -C -p1 \
%cabal_prep_online %{*} \
echo "Printing license summary for License field..." \
%cabal_license_summary_online

### genbr: unused
%buildsystem_terra_cabal_generate_buildrequires() %{nil}

### conf: unused
%buildsystem_terra_cabal_conf() %{nil}

### build: BuildOption(build) args go straight to cabal build
%buildsystem_terra_cabal_build() %cabal_build_online %{*}

### install: every built executable goes to %%{_bindir}
%buildsystem_terra_cabal_install() %cabal_install_bins_online %{*}

### check: unused, since tests would need their own freeze
%buildsystem_terra_cabal_check() %{nil}
