## Evaluation macro to expand later and a bcond for if Electron is bundled or not for meta/license macros so they can be used for Electron itself
## %%with_bundled_electron alone does not work because the name macro is defined in the spec itself
%is_electron_bundled() %bcond bundled_electron %["%{name}" != "electron"]

%electron_arches %{x86_64} %{ix86} %{arm64} armv7l armv7hl armv7hnl %{mips64}

## Capital letters denote use in desktop file or icon install process. These are capitalized differently for organizational purposes.
# If no alternative names are provided via flag everything, falls back to the name set by the spec
# -b: "Binary." Name of the actual executable file.
# -d: "Directory." Choose a different name for the install directory in /usr/lib(64)
# -D: "Desktop file." Handle automatic installation of .desktop file.
# -E: "Enable features." For use with desktop file install. Comma separated.
# -F: "Flags." Additional flags. Comma separated for each flag. Examples: no-sandbox disable-gpu-sandbox
# -O: "Ozone platform." For use with desktop file install. Default is "auto." Some programs MUST fall back to X11 for various reasons. Example: %%electron_install -O OR %%electron_install -Ox11
# -U:  Set %u or %U in the desktop file.
# -i: "Icons." Choose a different name to install the icon files under.
# -I: "Icon install." Boolean to handle automatic installation. ALSO accepts argumets, multiple icon files must be full paths AND end in their file extension, otherwise the flag assumes you are pointing it to the directory of the icon.
# -l: "Licenses." Use this if you want to collect all extra licenses into a directory called bundled_licenses automatically to package them via RPM. DOES NOT include build dep licenses. If using this macro you should add "%%license bundled_licenses/*" to the files section.
# -s: "Symlink." Name of the symlink to the executable.
# -S: Additional symlink to the binary. ONLY do this if a program has two common names, i.e, Heroic being called both "heroic" and "heroic-games-launcher"
# -v: "Verbose." Don't set +x for PNG icon installs. This WILL spam your terminal.
%electron_install_test(b:d:DE:F:i:IlO::s:S:U:v) %{-i:%{!?-I:%{expand:
%{error:Icon name provided but -I was not passed.}}}}                                  \
if cat package.json | grep electron-builder &>/dev/null; then                          \
  WEBAPP_BUILD_TOOL="electron-builder"                                                 \
  APPOUTDIR="./dist"                                                                   \
  if [[ "%{_electron_cpu}" == "x64" ]]; then                                           \
    OUTDIR="./dist/linux-unpacked"                                                     \
    APPARCH="x86_64"                                                                   \
  elif [[ "%{_electron_cpu}" == "ia32" ]]; then                                        \
    OUTDIR="./dist/linux-%{_electron_cpu}-unpacked"                                    \
    APPARCH="i386"                                                                     \
  else                                                                                 \
    OUTDIR="./dist/linux-%{_electron_cpu}-unpacked"                                    \
    APPARCH="%{_electron_cpu}"                                                         \
  fi                                                                                   \
elif cat package.json | grep electron-forge &>/dev/null; then                          \
  WEBAPP_BUILD_TOOL="electron-forge"                                                   \
  OUTDIR="./out/*-linux-%{_electron_cpu}"                                              \
  APPOUTDIR="./out/make/AppImage/%{_electron_cpu}"                                     \
  APPARCH="%{_electron_cpu}"                                                           \
elif cat package.json | grep tauri &>/dev/null; then                                   \
  echo -e '\\e[31mERROR:\\e[0m This is a Tauri package, this macro will not work!' >&2 \
  exit 1                                                                               \
fi                                                                                     \
%{lua:
  local bin = macros["-b*"] or macros["name"]
  local dir = macros["-d*"] or macros["name"]
  local installdir = rpm.expand("%{_libdir}/") .. dir
  local link = macros["-s*"] or macros["name"]
  print(rpm.expand("%{__mkdir} -p %{buildroot}") .. installdir .. "\\n")
  print(rpm.expand("%{__cp} -pr $OUTDIR/* -t %{buildroot}") .. installdir .. "\\n")
  print(rpm.expand("%{__mkdir} -p %{buildroot}%{_bindir}\\n"))
  print(macros["__ln_s"] .. "f " .. installdir .. "/" .. bin .. rpm.expand(" %{buildroot}%{_bindir}/") .. link .. "\\n")
  if opt.S then
    print(macros["__ln_s"] .. "f " .. installdir .. "/" .. bin .. rpm.expand(" %{buildroot}%{_bindir}/%{-S*}\\n"))
  end
  if opt.D then
    print(rpm.expand("$APPOUTDIR/*$APPARCH.AppImage --appimage-extract '*.desktop'\\n"))
    print(rpm.expand("%{__sed} -i '/.*AppImage.*/d' squashfs-root/*.desktop\\n"))
  if opt.F then
    function split(arguments, split_pattern)
      local arg_list = {}
      local pattern = '([^'..split_pattern..']+)'
      string.gsub(arguments, pattern, function(value) arg_list[#arg_list + 1] =     value;  end);
      return arg_list
    end
    if macros["-F*"]:find(",") then
      local flags = split(macros["-F*"], ",")
      macros["desktop_file_args"] = table.concat(flags, " --")
    else
      macros["desktop_file_args"] = macros["-F*"]
    end
  end
    print(rpm.expand("%{__desktop_file_install} --set-key=Exec --set-value=\\"") .. installdir .. "/" .. bin .. rpm.expand("%{-E: --enable-features=%{-E*}}%{-O:%{!?-O*: --ozone-platform-hint=auto}}%{-O*: --ozone-platform=%{-O*}}%{?desktop_file_args: --%{desktop_file_args}}%{-U: %{-U*}}\\" squashfs-root/*.desktop"))
  end
  if opt.I then
    local sizes = {"8", "16", "20", "24", "32", "36", "40", "44", "48", "64", "72", "96", "128", "150", "192", "256", "310", "512", "1024"}
    local icons = tonumber(rpm.expand("%#"))

    for i, icon in ipairs(arg) do
      if icon:find("%.png") then
        for i, size in ipairs(sizes) do
          if icon:find(size) and arg[2] then
              if (size == "8" or size == "24") and not (icon:find("%d" .. size) or icon:find(size .. "%d")) then
                rpm.define("install_icon_" .. size .. " %{__install} -Dm644 " .. icon .. " %{buildroot}%{_hicolordir}/" .. size .. "x" .. size .. "/apps/%{-i:%{-i*}}%{!?-i:%{name}}.png")
              elseif not (size == "8" or size == "24") and not (icon:find("%d" .. size) or icon:find(size .. "%d")) then
                rpm.define("install_icon_" .. size .. " %{__install} -Dm644 " .. icon .. " %{buildroot}%{_hicolordir}/" .. size .. "x" .. size .. "/apps/%{-i:%{-i*}}%{!?-i:%{name}}.png")
              end
          elseif icon:find(size) and not arg[2] then
            if (size == "8" or size == "24") and not (icon:find("%d" .. size) or icon:find(size .. "%d")) then
                rpm.define("install_icon_" .. size .. " %{__install} -Dm644 " .. icon .. " %{buildroot}%{_hicolordir}/" .. size .. "x" .. size .. "/apps/%{-i:%{-i*}}%{!?-i:%{name}}.png")
              elseif not (size == "8" or size == "24") and not (icon:find("%d" .. size) or icon:find(size .. "%d")) then
                rpm.define("install_icon_" .. size .. " %{__install} -Dm644 " .. icon .. " %{buildroot}%{_hicolordir}/" .. size .. "x" .. size .. "/apps/%{-i:%{-i*}}%{!?-i:%{name}}.png")
              end
            end
          if rpm.isdefined("install_icon_" .. size) then
            rpm.define("__electron_icon_install %{?install_icon_8:%{expand:\\
%{install_icon_8}}} %{?install_icon_16:%{expand:\\
%{install_icon_16}}} %{?install_icon_20:%{expand:\\
%{install_icon_20}}} %{?install_icon_24:%{expand:\\
%{install_icon_24}}} %{?install_icon_32:%{expand:\\
%{install_icon_32}}} %{?install_icon_36:%{expand:\\
%{install_icon_36}}} %{?install_icon_40:%{expand:\\
%{install_icon_40}}} %{?install_icon_44:%{expand:\\
%{install_icon_44}}} %{?install_icon_48:%{expand:\\
%{install_icon_48}}} %{?install_icon_64:%{expand:\\
%{install_icon_64}}} %{?install_icon_72:%{expand:\\
%{install_icon_72}}} %{?install_icon_96:%{expand:\\
%{install_icon_96}}} %{?install_icon_128:%{expand:\\
%{install_icon_128}}} %{?install_icon_150:%{expand:\\
%{install_icon_150}}} %{?install_icon_192:%{expand:\\
%{install_icon_192}}} %{?install_icon_256:%{expand:\\
%{install_icon_256}}} %{?install_icon_310:%{expand:\\
%{install_icon_310}}} %{?install_icon_512:%{expand:\\
%{install_icon_512}}} %{?install_icon_1024:%{expand:\\
%{install_icon_1024}}}")
          elseif not rpm.isdefined("install_icon_" .. size) and not rpm.isdefined("__electron_icon_install") then
            if arg[2] then
              rpm.define("__electron_icon_install %{expand:%{!?-v:%{expand:\\
set +x}} \\
echo \\"Installing icons.\\" \\
for size in 8 16 20 22 24 32 36 40 44 48 64 72 96 128 150 192 256 310 512 1024; do \\
for icon in " .. table.concat(arg, " ") .. "; do \\
if file $icon | grep \\"$size x $size\\" &>/dev/null; then \\
echo -e \\"Found icon for size \\\\\\\\e[32m${size}x${size}\\\\\\\\e[0m.\\" >&2 %{!?-v:%{expand:\\
set -x}} \\
%{__install} -Dm644 $icon %{buildroot}%{_hicolordir}/${size}x${size}/apps/%{-i:%{-i*}}%{!?-i:%{name}}.png %{!?-v:%{expand:\\
set +x}} \\
fi \\
done \\
done %{!?-v:%{expand:\\
set -x}}}")
            else
          rpm.define("__electron_icon_install %{expand:\\
echo \\"Installing icons.\\" >&2 %{!?-v:%{expand:\\
set +x}} \\
for size in 8 16 20 22 24 32 36 40 44 48 64 72 96 128 150 192 256 310 512 1024; do \\
if file " .. arg[1] .. " | grep \\"$size x $size\\" &>/dev/null; then \\
echo -e \\"Found icon for size \\\\\\\\e[32m${size}x${size}\\\\\\\\e[0m.\\" >&2 %{!?-v:%{expand:\\
set -x}} \\
%{__install} -Dm644 " .. arg[1] .. " %{buildroot}%{_hicolordir}/${size}x${size}/apps/%{-i:%{-i*}}%{!?-i:%{name}}.png %{!?-v:%{expand:\\
set +x}} \\
fi \\
done %{!?-v:%{expand:\\
set -x}}}")
            end
          end
        end
      elseif icon:find("%.svg") then
      rpm.define("__electron_icon_install %{expand:\\
echo \\"Installing icons.\\" >&2 \\
echo -e \\"Found \\\\\\\\e[32mscalable (SVG)\\\\\\\\e[0m icon.\\" >&2 \\
%{__install} -Dm644 " .. arg[1] .. " %{buildroot}%{_scalableiconsdir}/%{-i:%{-i*}}%{!?-i:%{name}}.svg}")
      else
        rpm.define("_app_icon_dir " .. arg[1])
      end
    end
  end}                                                                                 \
%{-l:%{expand:BUNDLED_LICENSE_DIR="$PWD/bundled_licenses"
%{__mkdir} -p $BUNDLED_LICENSE_DIR
find ./*/ -iname "*LICENSE*" -type f ! -name "*.zip" ! -path "./node_modules/*" ! -path "./*/node_modules/*" ! -path "./public/*" ! -name "$BUNDLED_LICENSE_DIR" ! -path "./$BUNDLED_LICENSE_DIR/*" -exec cp -p -t $BUNDLED_LICENSE_DIR {} +}} %{-I:%{expand:
if [[ "$WEBAPP_BUILD_TOOL" == "electron-builder" ]]; then %{?__electron_icon_install}%{!?__electron_icon_install:%{expand:
echo "Installing icons." >&2 %{!?-v:%{expand:
set +x}}
for size in 8 16 20 22 24 32 36 40 44 48 64 72 96 128 150 192 256 310 512 1024; do
for icon in %{!?_app_icon_dir:dist/.icon-set}%{?_app_icon_dir}/*.png; do
if file $icon | grep "$size x $size" &>/dev/null; then
echo -e "Found icon for size \\e[32m${size}x${size}\\e[0m." >&2
%{__install} -Dm644 $icon %{buildroot}%{_hicolordir}/${size}x${size}/apps/%{-i:%{-i*}}%{!?-i:%{name}}.png
fi
done
done %{!?-v:%{expand:
set -x}}}}
elif [[ "$WEBAPP_BUILD_TOOL" == "electron-forge" ]]; then %{?__electron_icon_install}%{!?__electron_icon_install:%{expand:
echo "Installing icons." >&2 %{!?-v:%{expand:
set +x}}
for size in 8 16 20 22 24 32 36 40 44 48 64 72 96 128 150 192 256 310 512 1024; do
for icon in %{!?_app_icon_dir:assets}%{?_app_icon_dir}/*icon.png; do
if file $icon | grep "$size x $size" &>/dev/null; then
echo -e "Found icon for size \\e[32m${size}x${size}\\e[0m." >&2 %{!?-v:%{expand:
set -x}}
%{__install} -Dm644 $icon %{buildroot}%{_hicolordir}/${size}x${size}/apps/%{-i:%{-i*}}%{!?-i:%{name}}.png %{!?-v:%{expand:
set +x}}
fi
done
done %{!?-v:%{expand:
set -x}}}}
fi}}
