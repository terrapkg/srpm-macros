# https://github.com/rust-lang/crates.io/discussions/13863#discussioncomment-17255004
%terra_crates_source https://static.crates.io/crates/%{crate}/%{crate}-%{version}.crate

%terra_rustflags %{build_rustflags} %[%{defined fedora} && %{with mold} ? "-Clink-arg=-fuse-ld=mold" : ""]

%cargo_prep_online %{expand:
%{!?_cargo_home:%%global _cargo_home %{rpmbuilddir}%{?buildsubdir:/%{buildsubdir}}/.cargo}} \
(\
set -eu \
%{__mkdir} -p target/rpm\
%{__ln_s} rpm target/release\
%{!?with_rust_nightly:%{expand:
%{__rm} -rf {.cargo/,%{_cargo_home}/}
%{__mkdir} -p %{_cargo_home}}}\
cat > %{_cargo_home}/config.toml << EOF \
[profile.rpm]\
inherits = "release"\
opt-level = %{rustflags_opt_level}\
codegen-units = %{rustflags_codegen_units}\
debug = %{rustflags_debuginfo}\
strip = "none"\
\
[build]\
rustc = "%{__rustc}"\
rustdoc = "%{__rustdoc}"\
\
[env]\
CFLAGS = "%{build_cflags}"\
CXXFLAGS = "%{build_cxxflags}"\
LDFLAGS = "%{build_ldflags}"\
\
[install]\
root = "%{buildroot}%{_prefix}"\
\
[term]\
verbose = true\
\
[source]\
\
[source.local-registry]\
directory = "%{cargo_registry}"\
\
EOF\
%{__rm} -f Cargo.toml.orig \
)\
%{expand:%{!?rhel:%%global build_rustflags %{terra_rustflags}}
%{!?with_rust_nightly:%%global __cargo /usr/bin/env CARGO_HOME=%{_cargo_home} RUSTC_BOOTSTRAP=1 RUSTFLAGS='%{build_rustflags}' /usr/bin/cargo}}

# Prepare a Cargo project against an already-vendored dependency tree. This
# must be used instead of %%cargo_prep_online when the build is offline.
# The vendor directory is expected at the project root and must be generated
# from the committed Cargo.lock before creating the source archive.
%cargo_prep_vendor %{expand:
%cargo_prep_online
test -f Cargo.lock || { echo 'cargo_prep_vendor requires Cargo.lock' >&2; exit 1; }
test -d vendor || { echo 'cargo_prep_vendor requires a vendor/ directory' >&2; exit 1; }
cat >> %{_cargo_home}/config.toml << EOF
[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "$(pwd)/vendor"
EOF
}

# Build using only the locked dependency graph and local sources. Use this
# with %%cargo_prep_vendor (or another preparation macro that configures a
# vendored source).
%cargo_build_offline CARGO_NET_OFFLINE=true %{__cargo} build -j${RPM_BUILD_NCPUS} --offline --locked %{?with_rust_nightly:-Z avoid-dev-deps} --profile rpm

# Resolve the locked dependency graph using only the configured local sources.
# Run after %%cargo_prep_vendor when a fast pre-build validation is useful.
%cargo_verify_vendor CARGO_NET_OFFLINE=true %{__cargo} metadata --offline --locked --no-deps >/dev/null


# cargo_license: print license information for all crate dependencies
#
# The "no-build,no-dev,no-proc-macro" argument results in only crates which are
# linked into the final binary to be considered.
#
# Additionally, deprecated SPDX syntax ("/" instead of "OR") is normalized
# before sorting the results to ensure reproducible output of this macro.
#
# This macro must be called with the same feature flags as other cargo macros,
# in particular, "cargo_build", otherwise its output will be incomplete.
#
# The "cargo tree" command called by this macro will fail if there are missing
# (optional) dependencies.
%cargo_license_online(naf:)\
(\
set -euo pipefail\
%{shrink:                                                                  \
    %{__cargo} tree                                                        \
    -Z avoid-dev-deps                                                      \
    --workspace                                                            \
    --edges no-build,no-dev,no-proc-macro                                  \
    --no-dedupe                                                            \
    --target all                                                           \
    %{__cargo_parse_opts %{-n} %{-a} %{-f:-f%{-f*}}}                       \
    --prefix none                                                          \
    --format "{l}: {p}"                                                    \
    | sed -e "s: ($(pwd)[^)]*)::g" -e "s: / :/:g" -e "\\|/.*:|{s|/| OR |}" \
    | sort -u                                                              \
}\
)

# cargo_license_summary: print license summary for all crate dependencies
#
# This macro works in the same way as cargo_license, except that it only prints
# a list of licenses, and not the complete license information for every crate
# in the dependency tree. This is useful for determining the correct License
# tag for packages that contain compiled Rust binaries.
%cargo_license_summary_online(naf:)\
(\
set -euo pipefail\
%{shrink:                                                           \
    %{__cargo} tree                                                 \
    -Z avoid-dev-deps                                               \
    --workspace                                                     \
    --edges no-build,no-dev,no-proc-macro                           \
    --no-dedupe                                                     \
    --target all                                                    \
    %{__cargo_parse_opts %{-n} %{-a} %{-f:-f%{-f*}}}                \
    --prefix none                                                   \
    --format "# {l}"                                                \
    | sed -e "s: / :/:g" -e "s:/: OR :g"                            \
    | sort -u                                                       \
}\
)

# cargo_vendor_manifest: write list of vendored crates and their versions
#
# The arguments for the internal "cargo tree" call emulate the logic
# that determines which crates are included when running "cargo vendor".
# The results are written to "cargo-vendor.txt".
%cargo_vendor_manifest_online()\
(\
set -euo pipefail\
%{shrink:                                                           \
    %{__cargo} tree                                                 \
    --workspace                                                     \
    --edges normal,build,dev                                        \
    --no-dedupe                                                     \
    --target all                                                    \
    --all-features                                                  \
    --prefix none                                                   \
    --format "{p}"                                                  \
    | grep -v "$(pwd)"                                              \
    | sed -e "s: (proc-macro)::"                                    \
    | sort -u                                                       \
    > cargo-vendor.txt                                              \
}\
)

# applicable to specs generated using rust2rpm
# where installing crate source as library is unnecessary, use this macro
# to install crates that build as single binary
%crate_install_bin (\
CRATE_NAME="$(%{__cargo_to_rpm} --path Cargo.toml name 2>/dev/null || echo "%{?crate}")" \
%{__install} -m 0755 target/rpm/$CRATE_NAME -D %{buildroot}%{_bindir}/$CRATE_NAME \
)

# Install all found Cargo binaries
%install_cargo_bins() \
find target/rpm \\\
    -maxdepth 1 -type f -executable ! -name '*.so' \\\
    -exec install -Dm755 -t %{buildroot}%{_bindir} {} +

# Install all found Cargo devel libs
%install_cargo_devel_libs() \
install -Dm755 target/rpm/*.so -t %{buildroot}%{_libdir}

# Install a Rustup toolchain into the isolated build directory. Prefer a dated
# toolchain (for example, nightly-2026-08-12) in package specs: the moving
# `nightly` channel makes rebuilds non-reproducible and can silently change the
# required compiler or LLVM version.
#
# -t: toolchain name (for example, nightly-2026-08-12)
# -f: rust-toolchain or rust-toolchain.toml file to read
# -c: optional component (for example, rust-src)
%rustup_toolchain(t:f:c:) %{expand:
%{?_cargo_home:%{error:%%rustup_toolchain must be run BEFORE %%cargo_prep or %%cargo_prep_online!}} \
%{!?-t:%{!?-f:%{error:%%rustup_toolchain requires -t <toolchain> or -f <file>}}} \
%global _cargo_home %{rpmbuilddir}%{?buildsubdir:/%{buildsubdir}}/.cargo \
%{__rm} -rf {.cargo/,%{_cargo_home}/} && \
%{__mkdir} -p %{_cargo_home} && \
%global _rustup_home %{rpmbuilddir}/.rustup \
%global __cargo . %{_cargo_home}/env && /usr/bin/env CARGO_HOME=%{_cargo_home} RUSTUP_HOME=%{_rustup_home} RUSTFLAGS='%{terra_rustflags}' %{_cargo_home}/bin/cargo \
%global __rustc %{_cargo_home}/bin/rustc \
%global __rustdoc %{_cargo_home}/bin/rustdoc \
/usr/bin/env CARGO_HOME=%{_cargo_home} RUSTUP_HOME=%{_rustup_home} RUSTUP_INIT_SKIP_PATH_CHECK=yes rustup-init --default-toolchain none -y -q --no-modify-path && \
. %{_cargo_home}/env && \
toolchain='%{-t*}' && \
components='%{-c*}' && \
%{?-f:toolchain_file='%{-f*}'; if test "$toolchain_file" = auto; then if test -f rust-toolchain.toml; then toolchain_file=rust-toolchain.toml; else toolchain_file=rust-toolchain; fi; fi; test -f "$toolchain_file" || { echo "rustup toolchain file not found: $toolchain_file" >&2; exit 1; }; toolchain=$(awk -F'"' '/^[[:space:]]*channel[[:space:]]=/ { print $2; exit }' "$toolchain_file"); if test -z "$toolchain"; then toolchain=$(sed -n '1p' "$toolchain_file" | tr -d '[:space:]'); fi; file_components=$(awk -F'[][]' '/^[[:space:]]*components[[:space:]]=/ { print $2; exit }' "$toolchain_file" | tr -d '"' | tr ',' ' '); components="$components $file_components"; } \
test -n "$toolchain" || { echo 'unable to determine Rust toolchain' >&2; exit 1; } && \
case "$toolchain" in nightly) echo 'moving nightly channel is not reproducible; use nightly-YYYY-MM-DD' >&2;; esac && \
test -n "$toolchain" || { echo 'unable to determine Rust toolchain' >&2; exit 1; } && \
rustup toolchain install "$toolchain" --profile minimal && \
for component in $components; do rustup component add --toolchain "$toolchain" "$component"; done && \
rustup default "$toolchain" \
}

# Discover and install an upstream rust-toolchain file. This is intentionally
# a shell-time check because the source tree is only available in %%prep.
%rustup_toolchain_from_file %{rustup_toolchain -f auto}

# Check that the selected compiler is the expected dated toolchain. This is
# useful immediately after %%rustup_toolchain and before a long build.
%rustup_verify_toolchain(t:) %{expand:
%{!?-t:%{error:%%rustup_verify_toolchain requires -t <toolchain>}} \
test -x %{__rustc} || { echo 'configured rustc is not executable' >&2; exit 1; } && \
version=$(%{__rustc} --version) && \
echo "$version" && \
echo "$version" | grep -F -- '%{-t*}' >/dev/null || { echo "rustc does not match %{-t*}" >&2; exit 1; }
}

# Backwards-compatible shorthand for packages that intentionally track the
# moving nightly channel. New packages should use %%rustup_toolchain instead.
%rustup_nightly %rustup_toolchain -t nightly
%bcond rust_nightly 1
