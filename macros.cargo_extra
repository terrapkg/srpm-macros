# https://github.com/rust-lang/crates.io/discussions/13863#discussioncomment-17255004
%terra_crates_source https://static.crates.io/crates/%{crate}/%{crate}-%{version}.crate

# By default avoid dev-deps
# Consideration: Should this be upstreamed to cargo2rpm?
%__cargo_license_avoid_dev_deps 1

%terra_rustflags %{build_rustflags} %[%{__terra_use_lld} ? "-Clink-arg=-fuse-ld=lld" : ""]

# Path to the default cargo4rpm executable
%__cargo_for_rpm /usr/bin/cargo4rpm

# Define the $CARGO_HOME so Crates always download to the same location
%_cargo_home %{rpmbuilddir}%{?buildsubdir:/%{buildsubdir}}/.cargo

# Define $RUSTUP_HOME for vendored toolchains
%_rustup_home %{rpmbuilddir}/.rustup

# Fetch Cargo deps
%cargo_fetch(-) %{shrink: \
  /usr/bin/env \
  CARGO_HOME=%{_cargo_home} \
  CARGO_NET_OFFLINE=false \
  %{?with_vendored_rust:PATH="%{_cargo_home}/bin:$PATH" \
  %{_cargo_home}/bin/cargo} \
  %{!?with_vendored_rust:/usr/bin/cargo} \
  fetch \
  --locked \
}

%cargo_prep_online(u) \
%{!?rhel:%global build_rustflags %{terra_rustflags}} \
%{!?with_vendored_rust:%global __cargo /usr/bin/env CARGO_HOME=%{_cargo_home} RUSTC_BOOTSTRAP=1 RUSTFLAGS='%{build_rustflags}' /usr/bin/cargo} \
(\
set -eu \
%{__mkdir} -p target/rpm\
%{__ln_s} rpm target/release\
%{!?with_vendored_rust:%{expand:
%{__rm} -rf {.cargo/,%{_cargo_home}/}
%{__mkdir} -p %{_cargo_home}}}\
cat > %{_cargo_home}/config.toml << EOF \
[profile.rpm]\
inherits = "release"\
opt-level = %{rustflags_opt_level}\
codegen-units = %{rustflags_codegen_units}\
debug = %{rustflags_debuginfo}\
strip = "none"\
\
[build]\
rustc = "%{__rustc}"\
rustdoc = "%{__rustdoc}"\
\
[env]\
CFLAGS = "%{build_cflags}"\
CXXFLAGS = "%{build_cxxflags}"\
LDFLAGS = "%{build_ldflags}"\
\
[install]\
root = "%{buildroot}%{_prefix}"\
\
[term]\
verbose = true\
\ %{!?-u:%{expand:
[net]
offline = true
 }} \
[source]\
\
[source.local-registry]\
directory = "%{cargo_registry}"\
\
EOF\
%{__rm} -f Cargo.toml.orig \
) \
%cargo_fetch

# cargo_license: print license information for all crate dependencies
#
# The "no-build,no-dev,no-proc-macro" argument results in only crates which are
# linked into the final binary to be considered.
#
# Additionally, deprecated SPDX syntax ("/" instead of "OR") is normalized
# before sorting the results to ensure reproducible output of this macro.
#
# This macro must be called with the same feature flags as other cargo macros,
# in particular, "cargo_build", otherwise its output will be incomplete.
#
# The "cargo tree" command called by this macro will fail if there are missing
# (optional) dependencies.
%cargo_license_online(naf:)\
(\
set -euo pipefail\
%{shrink:                                                                        \
    %{__cargo} tree                                                              \
    %[%{__cargo_license_avoid_dev_deps} ? "-Z avoid-dev-deps" : ""]              \
    --workspace                                                                  \
    --edges no-build,no-dev,no-proc-macro                                        \
    --no-dedupe                                                                  \
    --target all                                                                 \
    %{__cargo_parse_opts %{-n} %{-a} %{-f:-f%{-f*}}}                             \
    --prefix none                                                                \
    --format "{l}: {p}"                                                          \
    | sed -e "s: ($(pwd)[^)]*)::g" -e ":b; s/^\\\([^:]*\\\)*\\\//\\\1 OR /; tb;" \
    | sort -u                                                                    \
}\
)

# cargo_license_preamble_online: print concatenated license summary for all crate dependencies
#
# This macro works in the same way as cargo_license, except that it only prints
# a list of licenses, and not the complete license information for every crate
# in the dependency tree. This is useful for determining the correct License
# tag for packages that contain compiled Rust binaries.
#
# The list of licenses are concatenated and can be directly pasted into `License:`.
%cargo_license_preamble_online(naf:)\
(\
set -euo pipefail\
%{shrink:                                                           \
    %{__cargo} tree                                                 \
    %[%{__cargo_license_avoid_dev_deps} ? "-Z avoid-dev-deps" : ""] \
    --workspace                                                     \
    --edges no-build,no-dev,no-proc-macro                           \
    --no-dedupe                                                     \
    --target all                                                    \
    %{__cargo_parse_opts %{-n} %{-a} %{-f:-f%{-f*}}}                \
    --prefix none                                                   \
    --format "{l}"                                                  \
    | sed -E 's@ */ *@ OR @g;/ /s@^.*$@(&)@'                        \
    | sort -u | sed -z 's/\\\n\\\+\\\([^\\\n]\\\)/ AND \\\1/g'      \
}\
)

# cargo_license_summary: print license summary for all crate dependencies
#
# This macro works in the same way as cargo_license, except that it only prints
# a list of licenses, and not the complete license information for every crate
# in the dependency tree. This is useful for determining the correct License
# tag for packages that contain compiled Rust binaries.
%cargo_license_summary_online(naf:)\
(\
set -euo pipefail\
%{shrink:                                                           \
    %{__cargo} tree                                                 \
    %[%{__cargo_license_avoid_dev_deps} ? "-Z avoid-dev-deps" : ""] \
    --workspace                                                     \
    --edges no-build,no-dev,no-proc-macro                           \
    --no-dedupe                                                     \
    --target all                                                    \
    %{__cargo_parse_opts %{-n} %{-a} %{-f:-f%{-f*}}}                \
    --prefix none                                                   \
    --format "# {l}"                                                \
    | sed -e "s: / :/:g" -e "s:/: OR :g"                            \
    | sort -u                                                       \
}\
)

# cargo_vendor_manifest: write list of vendored crates and their versions
#
# The arguments for the internal "cargo tree" call emulate the logic
# that determines which crates are included when running "cargo vendor".
# The results are written to "cargo-vendor.txt".
%cargo_vendor_manifest_online()\
(\
set -euo pipefail\
%{shrink:                                                           \
    %{__cargo} tree                                                 \
    --workspace                                                     \
    --edges normal,build,dev                                        \
    --no-dedupe                                                     \
    --target all                                                    \
    --all-features                                                  \
    --prefix none                                                   \
    --format "{p}"                                                  \
    | grep -v "$(pwd)"                                              \
    | sed -e "s: (proc-macro)::"                                    \
    | sort -u                                                       \
    > cargo-vendor.txt                                              \
}\
)

# applicable to specs generated using rust2rpm
# where installing crate source as library is unnecessary, use this macro
# to install crates that build as single binary
%crate_install_bin (\
CRATE_NAME="$(%{__cargo_to_rpm} --path Cargo.toml name 2>/dev/null || echo "%{?crate}")" \
%{__install} -m 0755 target/rpm/$CRATE_NAME -D %{buildroot}%{_bindir}/$CRATE_NAME \
)

# Install all found Cargo binaries
%install_cargo_bins() \
find target/rpm \\\
    -maxdepth 1 -type f -executable ! -name '*.so' \\\
    -exec install -Dm755 -t %{buildroot}%{_bindir} {} +

# Install all found Cargo devel libs
%install_cargo_devel_libs() \
install -Dm755 target/rpm/*.so -t %{buildroot}%{_libdir}

# Best used in BuildSystems, but can be called on its own
%terra_cargo_install() \
%install_cargo_bins \
if stat target/rpm/*.so &>/dev/null; then \
install -Dm755 target/rpm/*.so -t %{buildroot}%{_libdir} \
fi

# Vendor a rust toolchain
# Limitation: -f* cannot properly set the nightly bcond as there is no way to set a macro from a runtime check
# -c: Set components to install. Comma separated.
# -t: Toolchain to install.
# -f: File to get toolchain from.
%vendor_rust(c:f:t:) \
%{!?-f*:%{!?-t*:%{error:-f or -t MUST be passed to this macro!}}} \
%{-f:%{-t:%{error:Cannot use both -f and -t!}}} \
%{-t:%{-f:%{error:Cannot use both -f and -t!}}} \
if [[ cat %{_cargo_home}/config.toml | grep '%{build_rustflags}' ]]; then \
echo -e '\\e[31mERROR:\\e[0m %%vendor_rust must be used BEFORE %%cargo_prep or %%cargo_prep_onine!' >&2 \
exit 1 \
fi \
%{__rm} -rf {.cargo/,%{_cargo_home}/} \
%{shrink:
  /usr/bin/env
  CARGO_HOME=%{_cargo_home}
  RUSTUP_HOME=%{_rustup_home}
  RUSTUP_INIT_SKIP_PATH_CHECK=yes
  /usr/bin/rustup-init
  %{-f*:--default-toolchain $(toml get toolchain.channel --toml-path %{-f*})}
  %{-t*:--default-toolchain %{-t*}}
  %{-c*:--component %{-c*}}
  -y
  --no-modify-path
} \
%{lua:
  if rpm.isdefined("-t*") and macros["-t*"]:find("nightly") then 
    rpm.define("__use_rust_nightly 1")
  else
    rpm.define("__use_rust_nightly 0")
  end} \
%bcond vendored_rust 1 \
%bcond rust_nightly %{__use_rust_nightly} \
%global __cargo %{shrink:
  /usr/bin/env
  CARGO_HOME=%{_cargo_home}
  RUSTUP_HOME=%{_rustup_home}
  PATH="%{_cargo_home}/bin:$PATH"
  %{!?with_rust_nightly:RUSTC_BOOTSTRAP=1}
  RUSTFLAGS='%{terra_rustflags}'
  %{_cargo_home}/bin/cargo
} \
%global __rustc %{_cargo_home}/bin/rustc \
%global __rustdoc %{_cargo_home}/bin/rustdoc

%rustup_nightly \
%{vendor_rust -t nightly}

# Generate build requirements from the lockfile.
# This DOES NOT scan the code for things the end package may link to, this simply looks for known Crates which need system dependencies.
%terra_cargo_generate_buildrequires() \
%{__cargo_for_rpm} buildrequires
