# Declarative buildsystem macros (usable with rpm >= 4.20)
# https://rpm-software-management.github.io/rpm/manual/buildsystem.html
# Effectively a copy of regular Cargo macros, but for Tauri

## Definition for "tauri" for genbr stage to determine BuildRequires
%buildsystem_tauri_generate_buildrequires() %tauri_generate_buildrequires %{*}

## Definition for "tauri" for conf stage, setting as empty due to non-use
%buildsystem_tauri_conf() %{nil}

## Definition for "tauri" for build stage for compiling with Tauri
## Webapps will probably NOT be buildable in declarative build systems but this has been ported anyway
%buildsystem_tauri_build() %tauri_build_crate %{*}

## Definition for "tauri" for install stage to install files into buildroot
%buildsystem_tauri_install() %tauri_install_crate %{*}

## Definition for "tauri" for check stage to run tests, setting as empty due to non-use
%buildsystem_tauri_check() %{nil}
